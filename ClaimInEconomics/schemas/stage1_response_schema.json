{
  "type": "json_schema",
  "json_schema": {
    "name": "stage1_extraction_response",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "cause": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "sign_of_impact": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "null effect",
                  "ambiguous",
                  "u_shaped"
                ]
              },
              
              "type_of_relationship": {
                "type": "string",
                "enum": [
                  "direct effect",
                  "indirect effect",
                  "confounding",
                  "mediation",
                  "collider",
                  "ancestor",
                  "descendant",
                  "bidirectional",
                  "association",
                  "other"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "causal_inference_method": {
                "type": "string",
                "enum": [
                  "RDD",
                  "DID",
                  "RCT",
                  "IV",
                  "Structural Estimation",
                  "Fixed Effects Models",
                  "Event Study",
                  "Simulation",
                  "Matching Methods",
                  "Synthetic Controls",
                  "VAR",
                  "Theoretical/Non-Empirical",
                  "Machine Learning Methods",
                  "Bayesian Methods",
                  "Other",
                  "Do not know"
                ]
              },
              "evidence_method_other_description": {
                "type": "string"
              },
              "sources_of_exogenous_variation": {
                "type": "string"
              },
              "level_of_tentativeness": {
                "type": "string",
                "enum": [
                  "certain",
                  "tentative"
                ]
              },
              "statistical_significance": {
                "type": "string",
                "enum": [
                  "p<0.01",
                  "0.01<=p<0.05",
                  "0.05<=p<0.1",
                  "p>0.1",
                  "NA"
                ]
              },
              "is_main_contribution": {
                "type": "boolean"
              }             
              
            },
            "required": [
              "claim",
              "cause",
              "effect",
              "evidence",
              "type_of_relationship",
              "sign_of_impact",
              "statistical_significance",
              "causal_inference_method",
              "evidence_method_other_description",
              "sources_of_exogenous_variation",
              "level_of_tentativeness",
              "is_main_contribution"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "edges"
        
      ],
      "additionalProperties": false
    }
  }
}
