
PAPERFLOW_DB_HOST=192.168.163.113
PAPERFLOW_DB_PORT=5432
PAPERFLOW_DB_USER=paperflow_admin
PAPERFLOW_DB_PASSWORD=replace-with-a-secret
PAPERFLOW_DB_NAME=paperflow
PAPERFLOW_DB_SCHEMA=paperflow
# Read-only OpenAlex dataset. Values may point to the same database with a
# different schema.
OPENALEX_DB_HOST=192.168.163.113
OPENALEX_DB_PORT=5432
OPENALEX_DB_USER=paperflow_openalex_reader
OPENALEX_DB_PASSWORD=replace-with-a-secret
OPENALEX_DB_NAME=openalex
OPENALEX_DB_SCHEMA=dataset_20241125
# Optional separate causal knowledge-graph database. Each value falls back to
# the corresponding PAPERFLOW_DB_* setting when unset.
# CAUSAL_DB_HOST=
# CAUSAL_DB_PORT=
# CAUSAL_DB_USER=
# CAUSAL_DB_PASSWORD=
# CAUSAL_DB_NAME=
# CAUSAL_DB_SCHEMA=
DATA_ROOT=/srv/paperflow/data
PAPER_UPLOAD_MAX_SIZE=100MB
PAPER_UPLOAD_MAX_BYTES=104857600

# Set to true only behind HTTPS. Keep false for local HTTP development.
SESSION_COOKIE_SECURE=false
