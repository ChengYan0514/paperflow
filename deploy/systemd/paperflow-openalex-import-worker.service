[Unit]
Description=Paperflow OpenAlex Journal Import Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperflow
Group=paperflow
WorkingDirectory=/opt/paperflow
EnvironmentFile=/etc/paperflow-admin/admin.env
Environment=LOG_FILE=/var/log/paperflow-admin/openalex-import-worker.log
ExecStart=/opt/paperflow/.venv/bin/paperflow --no-progress run-openalex-import-worker
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=027
NoNewPrivileges=true
LogsDirectory=paperflow-admin

[Install]
WantedBy=multi-user.target
