{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./src/.umi/*"],
      "@@test/*": ["./src/.umi-test/*"],
      "@root/*": ["./*"]
    }
  },
  "include": [
    "config/**/*.ts",
    "src/access.ts",
    "src/access.test.ts",
    "src/app.tsx",
    "src/app.test.tsx",
    "src/global.tsx",
    "src/global.style.ts",
    "src/loading.tsx",
    "src/pages/Login.tsx",
    "src/pages/Login.test.tsx",
    "src/pages/Knowledge/CausalGraph/**/*.tsx",
    "src/pages/Placeholder.tsx",
    "src/pages/BlocksReader.tsx",
    "src/pages/BlocksReader.test.tsx",
    "src/pages/BusinessPages.test.tsx",
    "src/pages/OriginalFileDetail.tsx",
    "src/pages/OriginalFileBlocks.tsx",
    "src/pages/OriginalFiles.tsx",
    "src/pages/Roles.tsx",
    "src/pages/Roles.test.tsx",
    "src/pages/SourceDetail.tsx",
    "src/pages/Sources.tsx",
    "src/pages/TaskStatus.tsx",
    "src/pages/TaskStatus.test.tsx",
    "src/pages/Users.tsx",
    "src/pages/Users.test.tsx",
    "src/pages/WorkDetail.tsx",
    "src/pages/WorkBlocks.tsx",
    "src/pages/Works.tsx",
    "src/pages/businessUtils.tsx",
    "src/pages/originalFileSummary.tsx",
    "src/services/admin.ts",
    "src/services/admin.test.ts",
    "src/services/auth.ts",
    "src/services/auth.test.ts",
    "src/services/business.ts",
    "src/services/business.test.ts",
    "src/services/knowledge.ts",
    "src/test/setupTests.ts",
    "src/typings.d.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/.umi", "src/.umi-production"]
}
